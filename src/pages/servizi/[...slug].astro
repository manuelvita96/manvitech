---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { shortLabel } from '../../data/serviceLabels';
import Faq from '../../components/Faq.astro';
import ChecklistLeadMagnet from '../../components/form/ChecklistLeadMagnet.tsx';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('pages');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, allServices: services },
  }));
}

const { service, allServices } = Astro.props;
const { Content } = await render(service);

const isQuick = service.data.order >= 10;
const otherServices = allServices
  .filter((s) => s.id !== service.id && (s.data.order >= 10) === isQuick)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: service.data.description,
  url: new URL(`/servizi/${service.id}`, 'https://manvitech.it').toString(),
  serviceType: service.data.seoTitle ?? service.data.title,
  provider: { '@id': 'https://manvitech.it/#organization' },
  areaServed: { '@type': 'Country', name: 'Italia' },
};
---

<Layout title={service.data.seoTitle ?? service.data.title} description={service.data.description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Servizi', href: '/servizi' }, { label: service.data.title, href: `/servizi/${service.id}` }]} />
  <article class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{service.data.title}</h1>
      <div class="prose-article mt-10">
        <Content />
      </div>
      {(service.id === 'consulenza-sito-esistente' || service.data.emergency) && (
        <div class="mt-10 rounded-3xl border border-red-200 bg-red-50 p-6 sm:p-8">
          <span class="badge border-red-200 text-red-600">Pronto intervento</span>
          <h2 class="mt-3 font-display text-xl font-bold text-ink-900">Il tuo sito è stato attaccato o è andato offline?</h2>
          <p class="mt-2 text-ink-600">Non perdere tempo: più si aspetta, più i danni crescono. Chiamaci subito, intervenire in fretta fa la differenza.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="tel:+393450639886" class="btn-primary w-full sm:w-auto">Chiama per un'emergenza</a>
            <a href="/contatti" class="btn-ghost w-full sm:w-auto">Scrivici</a>
          </div>
        </div>
      )}

      <a href="/contatti" class="btn-primary mt-10 inline-flex">
        {service.id === 'consulenza-sito-esistente' ? 'Richiedi il check gratuito' : isQuick ? 'Chiedi una valutazione' : 'Richiedi informazioni'}
      </a>

      {service.id === 'consulenza-sito-esistente' && (
        <div class="mt-10">
          <ChecklistLeadMagnet client:load />
        </div>
      )}

      {otherServices.length > 0 && (
        <div class="mt-16 border-t border-ink-100 pt-10">
          <h2 class="font-display text-lg font-semibold text-ink-900">Altri servizi che potrebbero interessarti</h2>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            {otherServices.map((s) => (
              <a href={`/servizi/${s.id}`} class="rounded-2xl border border-ink-100 p-4 text-sm font-medium text-ink-700 hover:border-brand-300 hover:text-brand-600">
                {shortLabel(s.id, s.data.title)}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <Faq items={service.data.faq} title="Domande frequenti" compact={false} />

  {service.id === 'consulenza-sito-esistente' && (
    <form name="lead-magnet-checklist" data-netlify="true" hidden>
      <input type="hidden" name="form-name" value="lead-magnet-checklist" />
      <input name="email" />
    </form>
  )}
</Layout>
