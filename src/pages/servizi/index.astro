---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const services = all.filter((s) => s.data.order < 10);
const quick = all.filter((s) => s.data.order >= 10);
---

<Layout
  title="Servizi"
  description="Siti internet, SEO, social e design, più consulenza e interventi rapidi su siti esistenti: sicurezza, velocità, hosting, email e domini."
>
  <Breadcrumbs items={[{ label: 'Servizi', href: '/servizi' }]} />
  <section class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge">I nostri servizi</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">Tutto quello che ti serve</h1>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {services.map((service) => (
        <a href={`/servizi/${service.id}`} class="rounded-3xl border border-ink-100 bg-white p-8 hover:border-brand-300" style="box-shadow: var(--shadow-card);">
          <h2 class="font-display text-xl font-semibold text-ink-900">{service.data.title}</h2>
          <p class="mt-2 text-ink-500">{service.data.description}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-brand-600">Scopri di più →</span>
        </a>
      ))}
    </div>

    <div class="mx-auto mt-20 max-w-2xl text-center">
      <span class="badge">Interventi rapidi</span>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">Un problema preciso? Lo risolviamo</h2>
      <p class="mt-3 text-ink-500">Lavori mirati su sito, hosting, email e domini, valutati caso per caso, in tutta Italia.</p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {quick.map((service) => (
        <a href={`/servizi/${service.id}`} class="rounded-3xl border border-ink-100 bg-white p-8 hover:border-brand-300" style="box-shadow: var(--shadow-card);">
          <h3 class="font-display text-lg font-semibold text-ink-900">{service.data.title}</h3>
          <p class="mt-2 text-ink-500">{service.data.description}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-brand-600">Scopri di più →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
