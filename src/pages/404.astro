---
import Layout from '../layouts/Layout.astro';
import BitAvatar from '../components/illustrations/BitAvatar.astro';
---

<Layout title="Pagina non trovata" description="La pagina che cerchi non esiste." noindex={true}>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <div class="w-28 sm:w-32" data-reveal="scale">
      <BitAvatar />
    </div>
    <span class="badge mt-6">Errore 404</span>
    <h1 class="mt-4 text-2xl font-bold text-ink-900">Ehm... questa pagina si è persa per strada</h1>
    <p class="mt-3 max-w-sm text-ink-500">
      Sono Bit: la pagina che cerchi potrebbe essere stata spostata, rinominata o non essere mai esistita.
      Ti riporto io sulla strada giusta.
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Torna alla home</a>
      <a href="/consiglio" class="btn-ghost">Chiedi un consiglio a Bit</a>
    </div>
  </section>
</Layout>

