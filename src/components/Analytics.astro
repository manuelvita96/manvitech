---
// Statistiche di visita con Umami Cloud (senza cookie, senza profilazione, dati aggregati).
// Si attiva solo se la variabile PUBLIC_UMAMI_WEBSITE_ID è impostata
// (Netlify → Site configuration → Environment variables, con scope "Builds").
// Dopo ogni modifica alla variabile serve un nuovo deploy (il sito è statico).
const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

{
  websiteId && (
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={websiteId}
      data-domains="manvitech.it,www.manvitech.it"
    />
  )
}
