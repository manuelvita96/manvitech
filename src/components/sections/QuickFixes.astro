---
import { getCollection } from 'astro:content';
import { shortLabel, EMERGENCY_TEL, EMERGENCY_TEL_LABEL } from '../../data/serviceLabels';

const quick = (await getCollection('pages'))
  .filter((p) => p.data.order >= 10)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="container-page py-16 sm:py-20" aria-labelledby="quickfixes-title">
  <div class="mx-auto max-w-2xl text-center">
    <span class="badge">Interventi rapidi</span>
    <h2 id="quickfixes-title" class="mt-4 font-display text-2xl font-bold text-ink-900 sm:text-3xl">
      Hai un problema preciso sul tuo sito?
    </h2>
    <p class="mt-3 text-ink-500">
      Sicurezza, velocità, hosting, email e domini: lavori mirati, valutati caso per caso, in tutta Italia.
    </p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {quick.map((p) => (
      <a href={`/servizi/${p.id}`} class="rounded-2xl border border-ink-100 bg-white p-5 transition-colors hover:border-brand-300" style="box-shadow: var(--shadow-card);">
        <h3 class="font-display text-base font-semibold text-ink-900">{shortLabel(p.id, p.data.title)}</h3>
        <p class="mt-2 line-clamp-3 text-sm text-ink-500">{p.data.description}</p>
        <span class="mt-3 inline-block text-sm font-semibold text-brand-600">Scopri di più →</span>
      </a>
    ))}
  </div>

  <p class="mt-8 text-center text-sm text-ink-500">
    Emergenza? <a href={`tel:${EMERGENCY_TEL}`} class="font-semibold text-red-600 hover:underline">Chiama il pronto intervento: {EMERGENCY_TEL_LABEL}</a>
  </p>
</section>
