---
// Minigioco a mappa (stile Pokémon): stesse domande e stesso invio a Netlify
// Forms del vecchio BitAdvisor.tsx, ma raccontati come un percorso su una
// mappa invece che come una chat. Nessuna prop richiesta: è autonomo.
//
// L'invio finale usa lo stesso "form-name" (chiedi-a-bit) e gli stessi nomi
// di campo del form ombra nascosto in consiglio.astro, quindi Netlify lo
// riconosce e lo inoltra esattamente come faceva il vecchio componente.
---
<div class="game-card">
  <div class="hud">
    <span class="hud-step" id="hudStep">Passo 1/6</span>
    <div class="hud-bar"><div class="hud-bar-fill" id="hudBarFill" style="width:16.6%"></div></div>
    <span class="hud-stars" id="hudStars">⭐ 0</span>
    <button class="hud-sound" id="hudSound" aria-label="Audio">🔊</button>
    <button class="hud-sound" id="hudRestart" aria-label="Ricomincia da capo" title="Ricomincia da capo">↺</button>
  </div>

  <div class="map-wrap">
    <svg id="mapSvg" viewBox="0 0 400 470" preserveAspectRatio="xMidYMax slice">
      <defs>
        <pattern id="grassPattern" width="32" height="32" patternUnits="userSpaceOnUse">
          <rect width="32" height="32" fill="var(--grass-1)"/>
          <rect width="16" height="16" fill="var(--grass-2)"/>
          <rect x="16" y="16" width="16" height="16" fill="var(--grass-2)"/>
          <circle cx="8" cy="24" r="1.4" fill="var(--grass-tuft)" opacity="0.6"/>
          <circle cx="25" cy="6" r="1.4" fill="var(--grass-tuft)" opacity="0.6"/>
        </pattern>
        <pattern id="pathPattern" width="28" height="28" patternUnits="userSpaceOnUse">
          <rect width="28" height="28" fill="var(--path-1)"/>
          <circle cx="6" cy="8" r="1.3" fill="var(--path-2)" opacity="0.6"/>
          <circle cx="20" cy="18" r="1.3" fill="var(--path-2)" opacity="0.6"/>
          <circle cx="14" cy="4" r="1" fill="var(--path-2)" opacity="0.5"/>
        </pattern>
        <pattern id="asphaltPattern" width="22" height="22" patternUnits="userSpaceOnUse">
          <rect width="22" height="22" fill="var(--asphalt-1)"/>
          <circle cx="5" cy="6" r="1" fill="var(--asphalt-2)" opacity="0.7"/>
          <circle cx="16" cy="14" r="1.1" fill="var(--asphalt-2)" opacity="0.7"/>
          <circle cx="12" cy="3" r="0.8" fill="#000" opacity="0.15"/>
        </pattern>
      </defs>

      <!-- terreno: riempie l'intera area di gioco, nessun "cielo" -->
      <rect id="groundRect" x="0" y="-320" width="400" height="1780" fill="url(#grassPattern)"/>

      <!-- il "mondo" scorrevole: sentiero, alberi, edificio, avatar -->
      <g id="world"></g>
    </svg>
  </div>

  <div class="dialogue" id="dialogue">
    <span class="dialogue-tag" id="dialogueTag">Bit</span>
    <p class="dialogue-text" id="dialogueText"><span class="caret">▍</span></p>
  </div>

  <div class="answers" id="answers"></div>
</div>

<style is:global>
  .game-card {
    --brand-500:#ED7D31; --brand-600:#DB6A1E; --brand-100:#FCE6D3;
    --accent-500:#F0396A; --accent-600:#D42457;
    --ink-900:#262626; --ink-700:#4B4640; --ink-400:#948C82; --ink-100:#EFE9DE; --ink-50:#F8F4EC;
    --paper:#FFFCF6;
    --grass-1:#7CC168; --grass-2:#6DAE59; --grass-dark:#4E8A44; --grass-tuft:#3F7538;
    --path-1:#E9D3A0; --path-2:#B6885A; --path-edge:#8C6239;
    --asphalt-1:#5B6068; --asphalt-2:#4A4E55; --asphalt-edge:#33363B; --asphalt-line:#F4E7C8;
    --curb:#E7E2D6;
    --rock-1:#B9B4AA; --rock-2:#8C877E; --water-1:#6FC7E0; --water-2:#4FA6C4;
    --bark:#6E4A2A; --bark-dark:#4E3319;
    --gold:#FFC94D;
    --shadow-card: 0 18px 40px -18px rgba(38,32,24,0.35);
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  button, a, svg, .fork-hint, .choice-btn { -webkit-tap-highlight-color: transparent; outline: none; -webkit-touch-callout: none; }
  button:focus, .fork-hint:focus, svg:focus { outline: none; }
  .map-wrap svg * { -webkit-tap-highlight-color: transparent; }
  .game-card {
    width: 100%; max-width: 460px; margin: 0 auto; background: var(--paper); border-radius: 28px;
    overflow: hidden; border: 1px solid var(--ink-100); box-shadow: var(--shadow-card);
  }

  /* ---------- HUD ---------- */
  .hud {
    display:flex; align-items:center; gap:12px; padding: 10px 16px;
    background: var(--ink-50); border-bottom: 1px solid var(--ink-100);
  }
  .hud-step { font-size: 11px; font-weight: 800; color: var(--ink-400); white-space:nowrap; }
  .hud-bar { flex:1; height:6px; border-radius:99px; background: var(--ink-100); overflow:hidden; }
  .hud-bar-fill { height:100%; border-radius:99px; background: linear-gradient(90deg, var(--brand-500), var(--accent-500)); transition: width .5s ease; }
  .hud-stars { font-size:13px; font-weight:800; color: var(--brand-600); display:flex; align-items:center; gap:3px; white-space:nowrap; }
  .hud-stars.pop { animation: pop .4s ease-out; }
  @keyframes pop { 0%{transform:scale(1)} 40%{transform:scale(1.3)} 100%{transform:scale(1)} }
  .hud-sound { border:none; background:transparent; cursor:pointer; font-size:15px; padding:4px 6px; border-radius:99px; color: var(--ink-400); }
  .hud-sound:hover { background: var(--ink-100); }

  /* ---------- MAP ---------- */
  .map-wrap {
    position: relative; width: 100%; aspect-ratio: 400 / 470; overflow: hidden;
    background: var(--grass-1);
    border-bottom: 3px solid var(--grass-dark);
  }
  .map-wrap svg { display:block; width:100%; height:100%; }
  .signpost-label {
    font-family:'Nunito', sans-serif; font-weight: 800; font-size: 11px; fill: var(--ink-900);
  }
  .fork-hint { cursor:pointer; }
  .fork-hint:focus-visible .fork-badge rect:first-child { stroke: var(--accent-600); stroke-width: 4.5; }
  .fork-badge { transform-box: fill-box; transform-origin: center; }
  .avatar-bob { animation: bob 1.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .avatar-bob.walking { animation: none; }
  @keyframes bob { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-3.5px);} }
  .avatar-bump { animation: abump .5s cubic-bezier(.34,1.56,.64,1) !important; }
  @keyframes abump { 0%{transform:translateY(0) scale(1)} 30%{transform:translateY(-9px) scale(1.08)} 60%{transform:translateY(0) scale(.96)} 100%{transform:translateY(0) scale(1)} }
  .building-glow { animation: glow 1.8s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes glow { 0%,100%{ opacity:.55 } 50%{ opacity:1 } }
  .waving-hand { animation: wave .7s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: 0% 100%; }
  @keyframes wave { from{ transform: rotate(-8deg);} to{ transform: rotate(30deg);} }

  .confetti-piece { animation: fall ease-in forwards; }
  @keyframes fall { from{ transform: translateY(0) rotate(0deg); opacity:1;} to{ transform: translateY(300px) rotate(480deg); opacity:0;} }

  /* ---------- DIALOGUE ---------- */
  .dialogue {
    position: relative; margin: -22px 16px 0; padding: 14px 16px 12px; background: white;
    border-radius: 18px; border: 1px solid var(--ink-100); box-shadow: var(--shadow-card); cursor: pointer;
  }
  .dialogue-tag {
    display:inline-block; font-family:'Baloo 2', sans-serif; font-weight:700; font-size:12px;
    color:white; padding: 3px 12px; border-radius: 99px;
    background: linear-gradient(135deg, var(--brand-500), var(--accent-500));
  }
  .dialogue-tag.user-tag { background: var(--ink-900); }
  .dialogue-text { margin: 8px 0 0; font-size: 14.5px; line-height:1.5; min-height: 2.8em; }
  .caret { animation: blink .9s steps(1) infinite; color: var(--brand-500); }
  @keyframes blink { 0%,50%{opacity:1} 50.01%,100%{opacity:0} }

  /* ---------- ANSWER AREA ---------- */
  .answers { padding: 14px 16px 20px; }
  .choices-row { display:grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .choice-btn {
    display:flex; flex-direction:column; align-items:center; gap:4px; text-align:center;
    padding: 12px 8px 10px; border-radius:16px; border:none; cursor:pointer;
    font-family:'Nunito', sans-serif; font-weight:800; font-size:12.5px; color:white;
    box-shadow: 0 5px 0 var(--btn-shadow); transition: transform .08s ease, box-shadow .08s ease;
    animation: choicein .35s ease-out backwards;
  }
  .choice-btn:nth-child(2){ animation-delay:.06s; }
  .choice-btn:active { transform: translateY(4px); box-shadow: 0 0 0 var(--btn-shadow); }
  @keyframes choicein { from{ opacity:0; transform:translateY(6px);} to{ opacity:1; transform:translateY(0);} }
  .choice-emoji { font-size: 22px; }
  .choice-arrow { font-size: 11px; opacity:.85; }

  .name-form, .email-form { display:flex; flex-direction:column; gap:10px; }
  .name-row { display:flex; gap:8px; }
  .text-input {
    width:100%; border:1px solid var(--ink-100); border-radius:99px; padding:10px 16px;
    font-family:'Nunito'; font-size:14px; outline:none; background: var(--ink-50);
  }
  .text-input:focus { border-color: var(--brand-500); background:white; box-shadow: 0 0 0 3px var(--brand-100); }
  .email-form .text-input { border-radius:12px; background:white; }
  .bit-btn-primary {
    font-family:'Baloo 2', sans-serif; font-weight:700; color:white; border:none; cursor:pointer;
    background: linear-gradient(135deg, var(--brand-500), var(--accent-500));
    padding: 10px 20px; border-radius:99px; box-shadow: 0 5px 0 var(--brand-600);
    transition: transform .08s ease;
  }
  .bit-btn-primary:active { transform: translateY(4px); box-shadow:none; }
  .bit-btn-primary:disabled { opacity:.45; cursor:not-allowed; }
  .consent { display:flex; gap:8px; align-items:flex-start; font-size:11.5px; color: var(--ink-700); }
  .consent input { margin-top:2px; accent-color: var(--brand-500); }
  .success-banner { display:flex; gap:8px; align-items:center; background: var(--brand-100); color: var(--brand-600); font-weight:800; font-size:13px; padding:10px 14px; border-radius:12px; }

  @media (prefers-reduced-motion: reduce) {
    .avatar-bob, .avatar-bump, .building-glow, .cloud-drift, .choice-btn, .confetti-piece, .caret { animation: none !important; }
  }
</style>

<script>
(function () {
  "use strict";

  /* ============ CONFIGURAZIONE MAPPA ============ */
  var VB_W = 400, FOCUS_Y = 370;
  // Inquadratura speciale per l'arrivo: l'edificio va vicino alla cima dello
  // schermo (non al solito punto fisso dell'omino), altrimenti sopra casa
  // resterebbe un grosso vuoto di prato — non c'è altra strada oltre la meta.
  var ARRIVAL_FOCUS_Y = 130;
  var STEP_DY = 220;
  var FORK_DX = 65;
  var X_MIN = 90, X_MAX = 310;
  // y di ogni nodo: 0=partenza .. 5=edificio
  var NODE_Y = [1230, 1010, 790, 570, 350, 140];

  var DECOR = [
    {type:'hill',   x: 200, y: 1330, s: 1},
    {type:'tree',   x: 150, y: 1300, s: .85},
    {type:'bush',   x: 250, y: 1305, s: .9},
    {type:'pebbles',x: 40,  y: 1290, s: 1},
    {type:'fruit-tree', x: 38,  y: 1250, s: .95, fruit:'red'},
    {type:'flower', x: 305, y: 1265, s: 1},
    {type:'fence',  x: 100, y: 1260, s: .8},
    {type:'bush',   x: 15,  y: 1200, s: .9},
    {type:'water',  x: 370, y: 1220, s: .9},
    {type:'tree',   x: 38,  y: 1150, s: 1},
    {type:'tree',   x: 360, y: 1130, s: .9},
    {type:'fruit-bush', x: 68,  y: 1080, s: 1},
    {type:'flower', x: 300, y: 1180, s: 1},
    {type:'pebbles',x: 335, y: 1110, s: 1},
    {type:'mushroom', x: 78, y: 1010, s: 1},
    {type:'flower', x: 15,  y: 1040, s: 1},
    {type:'water',  x: 20,  y: 995,  s: 1},
    {type:'rock',   x: 340, y: 1000, s: 1},
    {type:'bush',   x: 320, y: 1040, s: .85},
    {type:'fruit-tree', x: 42,  y: 940,  s: .95, fruit:'orange'},
    {type:'flower', x: 375, y: 950,  s: 1},
    {type:'water',  x: 355, y: 880,  s: 1},
    {type:'pebbles',x: 22,  y: 860,  s: 1},
    {type:'tallgrass', x: 300, y: 900, s: 1},
    {type:'bush',   x: 60,  y: 800,  s: .9},
    {type:'flower', x: 375, y: 820,  s: 1},
    {type:'tree',   x: 365, y: 760,  s: 1},
    {type:'flower', x: 45,  y: 700,  s: 1},
    {type:'haystack', x: 335, y: 700, s: 1},
    {type:'fruit-bush', x: 20,  y: 660,  s: .95},
    {type:'river',  y: 900, wobble: 16, slope: 70},
    {type:'rock',   x: 355, y: 630,  s: .85},
    {type:'flower', x: 320, y: 670,  s: 1},
    {type:'fruit-tree', x: 40,  y: 580,  s: 1, fruit:'red'},
    {type:'bush',   x: 355, y: 500,  s: 1},
    {type:'flower', x: 375, y: 550,  s: 1},
    {type:'pebbles',x: 340, y: 560,  s: 1},
    {type:'water',  x: 360, y: 440,  s: .9},
    {type:'flower', x: 60,  y: 440,  s: 1},
    {type:'mushroom', x: 24, y: 500,  s: 1.1},
    {type:'bush',   x: 18,  y: 480,  s: .9},
    {type:'tree',   x: 360, y: 400,  s: .9},
    {type:'river',  y: 460, wobble: 14, loop: true, side: 'right'},
    {type:'river',  y: 245, wobble: 14, loop: true, side: 'left'},
    {type:'rock',   x: 42,  y: 330,  s: 1},
    {type:'flower', x: 20,  y: 380,  s: 1},
    {type:'water',  x: 375, y: 350,  s: .8},
    {type:'fruit-tree', x: 355, y: 280,  s: 1, fruit:'orange'},
    {type:'bush',   x: 45,  y: 220,  s: .95},
    {type:'flower', x: 375, y: 250,  s: 1},
    {type:'tallgrass', x: 335, y: 200, s: 1},
    {type:'pebbles',x: 300, y: 220,  s: 1},
    {type:'tree',   x: 130, y: 60,   s: .9},
    {type:'fence',  x: 340, y: 100,  s: .75},
    {type:'hill',   x: 60,  y: 100,  s: .8},
    {type:'tree',   x: 280, y: 60,   s: .9},
    {type:'flower', x: 90,  y: 150,  s: 1},
    {type:'flower', x: 310, y: 150,  s: 1},
    {type:'bush',   x: 100, y: 190,  s: .9},
    {type:'bush',   x: 300, y: 190,  s: .9},
    {type:'flower', x: 60,  y: 60,   s: 1},
    {type:'flower', x: 340, y: 60,   s: 1}
  ];

  /* ============ DOMANDE (albero binario) ============ */
  function getQuestion(stepIndex, data) {
    if (stepIndex === 0) {
      return {
        key: 'hasSite',
        text: 'Piacere' + (data.name ? ', ' + data.name : '') + '! Hai già un sito, o parti da zero?',
        left:  { value: 'ha-gia-sito',   label: 'Ho già un sito', emoji: '🌐' },
        right: { value: 'parto-da-zero', label: 'Parto da zero',  emoji: '🌱' }
      };
    }
    if (stepIndex === 1) {
      if (data.hasSite === 'ha-gia-sito') {
        return {
          key: 'siteProblem',
          text: 'Cosa ti frustra di più del tuo sito attuale?',
          left:  { value: 'lento',         label: 'È lento',            emoji: '🐢' },
          right: { value: 'pochi-clienti', label: 'Non porta clienti',  emoji: '📉' }
        };
      }
      return {
        key: 'businessType',
        text: 'Che tipo di attività hai, o vuoi far conoscere?',
        left:  { value: 'negozio-locale',  label: 'Negozio locale',        emoji: '🏪' },
        right: { value: 'professionista',  label: 'Prof. o azienda',       emoji: '💼' }
      };
    }
    if (stepIndex === 2) {
      return {
        key: 'targetAudience',
        text: 'A chi vuoi rivolgerti principalmente?',
        left:  { value: 'privati', label: 'Privati e famiglie', emoji: '👨‍👩‍👧' },
        right: { value: 'aziende', label: 'Aziende (B2B)',      emoji: '🤝' }
      };
    }
    // stepIndex === 3
    return {
      key: 'timeline',
      text: 'Ultima cosa: quando vorresti partire?',
      left:  { value: 'subito',    label: 'Il prima possibile', emoji: '🚀' },
      right: { value: 'valutando', label: 'Sto solo valutando', emoji: '🔍' }
    };
  }
  var TOTAL_QUESTIONS = 4; // hasSite, (siteProblem|businessType), targetAudience, timeline

  /* ============ STATO ============ */
  // rispetta l'impostazione di sistema "riduci movimento": niente camminata a
  // scatti né scorrimento della camera, il gioco resta comunque giocabile
  var REDUCE_MOTION = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var state = {
    stepIndex: 0,          // indice domanda corrente (0..3)
    nodeIndex: 0,           // nodo mappa corrente (0..5)
    data: { name: '', hasSite:'', siteProblem:'', businessType:'', targetAudience:'', timeline:'', email:'', phone:'', consent:false },
    nodes: [{ x: 200, y: NODE_Y[0] }],
    pastForks: [], // bivi già superati: il ramo non scelto resta sempre visibile
    combo: 0,
    soundOn: true,
    phase: 'name' // name | question | arriving | summary | done
  };

  /* ============ AUDIO ============ */
  var audioCtx = null;
  function getCtx() {
    if (!state.soundOn) return null;
    if (!audioCtx) {
      var AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return null;
      audioCtx = new AC();
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }
  function tone(freq, dur, type, delay, vol) {
    var ctx = getCtx(); if (!ctx) return;
    dur = dur || 0.1; type = type || 'sine'; delay = delay || 0; vol = vol || 0.14;
    var osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.type = type; osc.frequency.value = freq;
    var t0 = ctx.currentTime + delay;
    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.exponentialRampToValueAtTime(vol, t0 + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(t0); osc.stop(t0 + dur + 0.02);
  }
  var sounds = {
    tap: function () { tone(500, 0.07, 'triangle'); },
    step: function () { tone(420, 0.05, 'square', 0, 0.06); },
    star: function () { tone(784, 0.09, 'triangle'); tone(1046, 0.12, 'triangle', 0.06); },
    celebrate: function () { [523,659,784,1046].forEach(function (f,i){ tone(f,0.16,'triangle', i*0.1, 0.16); }); }
  };

  /* ============ HELPERS SVG ============ */
  var SVG_NS = 'http://www.w3.org/2000/svg';
  function el(tag, attrs) {
    var e = document.createElementNS(SVG_NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }
  var worldG = document.getElementById('mapSvg').querySelector('#world');

  function clampX(x) { return Math.max(X_MIN, Math.min(X_MAX, x)); }

  var PATH_W = 46; // larghezza del sentiero

  // Calcola i 4 punti di una curva "a gomito" fra due nodi: il parametro bend
  // (0..1) sposta il punto di svolta più vicino ad a (bend piccolo) o a b (bend
  // Curva vera (non una spezzata con angoli arrotondati): un'unica bezier
  // cubica da a a b, con le tangenti d'uscita/arrivo verticali — esattamente
  // come si incontrano i tratti dritti prima e dopo. Risultato: una svolta
  // che curva davvero, non uno spigolo a 90° con il bordo smussato.
  function smoothRoadD(a, b, bend) {
    bend = (bend === undefined) ? 0.5 : bend;
    var midY = a.y - (a.y - b.y) * bend;
    return 'M ' + a.x + ' ' + a.y + ' C ' + a.x + ' ' + midY + ' ' + b.x + ' ' + midY + ' ' + b.x + ' ' + b.y;
  }
  // Punto + tangente + normale sulla STESSA curva disegnata da smoothRoadD, al
  // parametro t (0=a, 1=b). Tutto quello che deve "stare sulla strada"
  // (ciuffi, ponti, delineatori, strisce, lampioni) usa questa funzione,
  // così non può mai disallinearsi da quello che si vede davvero a schermo.
  function curvePointAt(a, b, bend, t) {
    bend = (bend === undefined) ? 0.5 : bend;
    var midY = a.y - (a.y - b.y) * bend;
    var c1 = { x: a.x, y: midY }, c2 = { x: b.x, y: midY };
    var mt = 1 - t;
    var x = mt*mt*mt*a.x + 3*mt*mt*t*c1.x + 3*mt*t*t*c2.x + t*t*t*b.x;
    var y = mt*mt*mt*a.y + 3*mt*mt*t*c1.y + 3*mt*t*t*c2.y + t*t*t*b.y;
    var dx = 3*mt*mt*(c1.x-a.x) + 6*mt*t*(c2.x-c1.x) + 3*t*t*(b.x-c2.x);
    var dy = 3*mt*mt*(c1.y-a.y) + 6*mt*t*(c2.y-c1.y) + 3*t*t*(b.y-c2.y);
    var len = Math.hypot(dx, dy) || 1;
    return { x: x, y: y, tx: dx/len, ty: dy/len, nx: -dy/len, ny: dx/len };
  }
  // Campiona la curva a intervalli regolari (per lunghezza approssimativa, non
  // per t) — serve per piazzare i ciuffi d'erba attaccati davvero al bordo.
  function sampleCurve(a, b, bend, steps) {
    var pts = [];
    for (var i = 0; i <= steps; i++) pts.push(curvePointAt(a, b, bend, i / steps));
    return pts;
  }

  // Pianta i ciuffi d'erba campionando la VERA curva disegnata (la stessa
  // bezier di smoothRoadD), a distanza regolare e sempre appena oltre il
  // bordo scuro della strada — qualunque sia la forma della svolta, restano
  // sempre attaccati al bordo perché sono calcolati sullo stesso identico
  // profilo che si vede a schermo, non su un'approssimazione a parte.
  function addCurveTufts(parent, a, b, bend, w, junctions) {
    var edge = w / 2 + 6;
    var spacing = 26;
    // niente ciuffi vicino a un vero incrocio (un bivio, o il punto in cui più
    // tratti si uniscono): prima usavo solo un margine lungo la curva, ma con
    // più tratti che convergono nello stesso punto da angoli diversi non
    // bastava. Ora scarto qualunque candidato entro un raggio fisso da uno
    // qualsiasi dei punti-nodo reali, indipendentemente da quale tratto lo genera.
    var keepout = 30;
    var samples = sampleCurve(a, b, bend, 48);
    var acc = spacing;
    for (var j = 0; j < samples.length - 1; j++) {
      var p0 = samples[j], p1 = samples[j + 1];
      acc += Math.hypot(p1.x - p0.x, p1.y - p0.y);
      if (acc < spacing) continue;
      var tooClose = junctions && junctions.some(function (jp) { return Math.hypot(jp.x - p1.x, jp.y - p1.y) < keepout; });
      if (tooClose) continue;
      acc = 0;
      parent.appendChild(el('ellipse', { cx: p1.x + p1.nx * edge, cy: p1.y + p1.ny * edge, rx: 5.5, ry: 6, fill: 'var(--grass-tuft)' }));
      parent.appendChild(el('ellipse', { cx: p1.x - p1.nx * edge, cy: p1.y - p1.ny * edge, rx: 5.5, ry: 6, fill: 'var(--grass-tuft)' }));
    }
  }

  // Intersezione fra due segmenti (formula standard). Usata per capire ESATTAMENTE
  // dove la strada attraversa un fiume, qualunque sia la sua forma.
  function segIntersect(p1, p2, p3, p4) {
    var d = (p2.x - p1.x) * (p4.y - p3.y) - (p2.y - p1.y) * (p4.x - p3.x);
    if (Math.abs(d) < 1e-9) return null;
    var t = ((p3.x - p1.x) * (p4.y - p3.y) - (p3.y - p1.y) * (p4.x - p3.x)) / d;
    var u = ((p3.x - p1.x) * (p2.y - p1.y) - (p3.y - p1.y) * (p2.x - p1.x)) / d;
    if (t < 0 || t > 1 || u < 0 || u > 1) return null;
    return { x: p1.x + t * (p2.x - p1.x), y: p1.y + t * (p2.y - p1.y) };
  }

  function cubicPoints(a, b, c, d, n) {
    var out = [];
    for (var i = 0; i <= n; i++) {
      var t = i / n, mt = 1 - t;
      out.push({
        x: mt*mt*mt*a.x + 3*mt*mt*t*b.x + 3*mt*t*t*c.x + t*t*t*d.x,
        y: mt*mt*mt*a.y + 3*mt*mt*t*b.y + 3*mt*t*t*c.y + t*t*t*d.y
      });
    }
    return out;
  }

  // Punti campionati lungo il fiume — stessa forma esatta usata da drawRiver,
  // sia per il fiume dritto/obliquo sia per quello ad ansa: così un ponte
  // serve DAVVERO ad attraversarlo, non solo a coprirlo.
  function riverPolyline(r) {
    if (r.loop) {
      var side = r.side || 'left', wobble = r.wobble || 16;
      var edgeX = side === 'left' ? -70 : 470;
      var peakX = side === 'left' ? 175 : 225;
      var span = 95;
      var p0 = { x: edgeX, y: r.y - span };
      var p1 = { x: peakX, y: r.y - span*0.45 };
      var p2 = { x: peakX + (side === 'left' ? wobble : -wobble), y: r.y };
      var p3 = { x: peakX, y: r.y + span*0.45 };
      var p4 = { x: edgeX, y: r.y + span };
      return cubicPoints(p0, p1, p1, p2, 24).concat(cubicPoints(p2, p3, p3, p4, 24).slice(1));
    }
    var pts = [];
    for (var x = RIVER_LEFT; x <= RIVER_RIGHT; x += 12) pts.push({ x: x, y: riverY(r, x) });
    return pts;
  }

  function computeBridges(pairs, decorList) {
    var rivers = decorList.filter(function (d) { return d.type === 'river'; });
    if (!rivers.length) return [];
    var bridges = [];
    pairs.forEach(function (p) {
      // campiono la VERA curva disegnata (non più lo scheletro dritto): un
      // ponte deve stare esattamente dove la strada che si vede attraversa
      // il fiume, non dove la stava una vecchia rappresentazione geometrica.
      // Qualunque sia l'inclinazione della strada in quel punto, il ponte la
      // segue (viene ruotato), quindi qui non scarto più nessun incrocio.
      var road = sampleCurve(p.a, p.b, p.bend, 40);
      for (var i = 0; i < road.length - 1; i++) {
        rivers.forEach(function (r) {
          var riverPts = riverPolyline(r);
          for (var j = 0; j < riverPts.length - 1; j++) {
            var hit = segIntersect(road[i], road[i+1], riverPts[j], riverPts[j+1]);
            if (hit) {
              var dx = road[i+1].x - road[i].x, dy = road[i+1].y - road[i].y;
              var angle = Math.atan2(dx, -dy) * 180 / Math.PI; // 0 = ponte verticale, come la strada dritta
              bridges.push({ x: hit.x, y: hit.y, angle: angle });
            }
          }
        });
      }
    });
    // niente doppi ponti troppo vicini fra loro (es. proprio all'angolo di un bivio)
    var out = [];
    bridges.forEach(function (b) {
      var dup = out.some(function (o) { return Math.hypot(o.x - b.x, o.y - b.y) < 24; });
      if (!dup) out.push(b);
    });
    return out;
  }


  // y oltre la quale la strada è sterrata: sotto (valore più alto, più vicino
  // al punto di partenza) resta sterrato; da qui in poi, avvicinandosi al
  // paese, diventa asfaltata — come capita davvero avvicinandosi a un centro
  // abitato. La soglia coincide con un nodo, quindi ogni "passo" è o tutto
  // sterrato o tutto asfaltato, mai un tratto misto a metà.
  var ASPHALT_Y = NODE_Y[3];
  function isAsphaltPair(p) { return Math.max(p.a.y, p.b.y) <= ASPHALT_Y; }

  function drawDelineator(x, y, angle) {
    var g = el('g', { transform: 'translate(' + x + ',' + y + ') rotate(' + (angle || 0) + ')' });
    g.appendChild(el('ellipse', { cx: 0, cy: 6, rx: 3.4, ry: 1.4, fill: '#000', opacity: 0.18 }));
    g.appendChild(el('rect', { x: -2, y: -13, width: 4, height: 16, rx: 1.4, fill: '#F4F4F4', stroke: 'var(--ink-900)', 'stroke-width': 0.6 }));
    g.appendChild(el('rect', { x: -2.6, y: -12, width: 5.2, height: 4, fill: '#E1483D' }));
    return g;
  }
  // Un delineatore riflettente sul lato esterno, a metà di ogni curva vera:
  // usa la stessa curva disegnata, quindi è sempre esattamente sul bordo.
  function addCurveDelineator(parent, a, b, bend) {
    if (Math.abs(b.x - a.x) < 20) return; // quasi dritto: nessuna vera curva da segnalare
    var pt = curvePointAt(a, b, bend, 0.5);
    var side = (b.x > a.x) ? 1 : -1; // il lato esterno della curva
    var edge = PATH_W/2 + 9;
    parent.appendChild(drawDelineator(pt.x + pt.nx*edge*side, pt.y + pt.ny*edge*side));
  }


  function drawRoadSurface(parent, pairs, w, surface, junctions) {
    if (!pairs.length) return;
    var isAsphalt = surface === 'asphalt';
    var edgeColor = isAsphalt ? 'var(--asphalt-edge)' : 'var(--path-edge)';
    var fillRef = isAsphalt ? 'url(#asphaltPattern)' : 'url(#pathPattern)';
    var items = pairs.map(function (p) {
      return { p: p, curveD: smoothRoadD(p.a, p.b, p.bend) };
    });
    items.forEach(function (it) {
      parent.appendChild(el('path', { d: it.curveD, fill: 'none', stroke: edgeColor, 'stroke-width': w + 10, 'stroke-linecap': 'round' }));
    });
    if (isAsphalt) {
      // piccolo cordolo chiaro fra asfalto e bordo scuro, come un vero marciapiede/cunetta
      items.forEach(function (it) {
        parent.appendChild(el('path', { d: it.curveD, fill: 'none', stroke: 'var(--curb)', 'stroke-width': w + 4, 'stroke-linecap': 'round' }));
      });
    }
    items.forEach(function (it) {
      parent.appendChild(el('path', { d: it.curveD, fill: 'none', stroke: fillRef, 'stroke-width': w, 'stroke-linecap': 'round' }));
    });
    if (isAsphalt) {
      // mezzeria tratteggiata: la strada sterrata non ce l'ha, quella asfaltata sì
      items.forEach(function (it) {
        parent.appendChild(el('path', { d: it.curveD, fill: 'none', stroke: 'var(--asphalt-line)', 'stroke-width': 2.4, 'stroke-linecap': 'round', 'stroke-dasharray': '13 11', opacity: 0.85 }));
      });
      pairs.forEach(function (p) { addCurveDelineator(parent, p.a, p.b, p.bend); });
    } else {
      // ciuffi d'erba: campionati DIRETTAMENTE sulla curva vera (la stessa
      // disegnata sopra), non su un'approssimazione a segmenti dritti — così
      // restano sempre attaccati al bordo, qualunque sia la forma della svolta
      pairs.forEach(function (p) { addCurveTufts(parent, p.a, p.b, p.bend, w, junctions); });
    }
  }

  function drawRoadNetwork(parent, pairs, w, junctions) {
    w = w || PATH_W;
    var dirt = [], asphalt = [];
    pairs.forEach(function (p) { (isAsphaltPair(p) ? asphalt : dirt).push(p); });
    drawRoadSurface(parent, dirt, w, 'dirt', junctions);
    drawRoadSurface(parent, asphalt, w, 'asphalt', junctions);
  }

  // vicolo cieco decorativo: crea l'effetto "incrocio a tre vie" senza aggiungere una scelta reale
  function drawDeadEnd(parent, node, side) {
    var dx = (side === 'right' ? 26 : -26);
    var g = el('g', { class: 'ghost-road' });
    var stubEnd = { x: clampX(node.x + dx), y: node.y - 30 };
    // bend basso: si stacca quasi subito verso il lato, così non corre parallelo
    // e sovrapposto al tratto largo del bivio principale
    drawRoadNetwork(g, [{ a: node, b: stubEnd, bend: 0.2 }], PATH_W - 16);
    g.appendChild(drawRock(stubEnd.x, stubEnd.y - 6, 0.8));
    parent.appendChild(g);
  }

