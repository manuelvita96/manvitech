  // fiume decorativo: una banda blu ondulata, tenuta nei margini cosi non tocca mai la strada
  var WORLD_TOP = -320, WORLD_BOTTOM = 1460; // ben oltre tutto ciò che la camera può inquadrare
  // fiume decorativo orizzontale: entra da fuori il bordo sinistro ed esce da
  // fuori il bordo destro dello schermo, a una certa altezza. Appare e sparisce
  // da solo man mano che la camera scorre in verticale oltre quella fascia;
  // dove incrocia la strada, la strada (disegnata dopo) lo copre come un guado.
  var RIVER_LEFT = -70, RIVER_RIGHT = 470, RIVER_WAVELEN = 250;
  // y esatta del fiume dritto/obliquo in un punto x qualsiasi: usata sia per
  // disegnare la curva sia per calcolare dove mettere i ponti, cosi combaciano sempre
  function riverY(river, x) {
    var slope = river.slope || 0;
    var progress = (x - RIVER_LEFT) / (RIVER_RIGHT - RIVER_LEFT);
    var baseline = river.y - slope/2 + slope*progress;
    return baseline + (river.wobble || 16) * Math.sin((x - RIVER_LEFT) / RIVER_WAVELEN * Math.PI * 2);
  }

  function drawRiver(y, wobble, opts) {
    opts = opts || {};
    var g = el('g');
    var d, grassSpots = [];
    if (opts.loop) {
      // entra e rientra dallo stesso lato, come un'ansa: non attraversa mai da parte a parte
      var side = opts.side || 'left';
      var edgeX = side === 'left' ? -70 : 470;
      var peakX = side === 'left' ? 175 : 225;
      var span = 95;
      var p0 = { x: edgeX, y: y - span };
      var p1 = { x: peakX, y: y - span*0.45 };
      var p2 = { x: peakX + (side === 'left' ? wobble : -wobble), y: y };
      var p3 = { x: peakX, y: y + span*0.45 };
      var p4 = { x: edgeX, y: y + span };
      d = 'M ' + p0.x + ' ' + p0.y +
          ' C ' + p1.x + ' ' + p1.y + ' ' + p1.x + ' ' + p1.y + ' ' + p2.x + ' ' + p2.y +
          ' C ' + p3.x + ' ' + p3.y + ' ' + p3.x + ' ' + p3.y + ' ' + p4.x + ' ' + p4.y;
      grassSpots = [ { x: (p0.x+p2.x)/2, y: (p0.y+p2.y)/2 }, { x: (p2.x+p4.x)/2, y: (p2.y+p4.y)/2 } ];
    } else {
      // curva continua (seno + eventuale pendenza): la stessa identica formula
      // usata da riverY() per posizionare i ponti, così non si sfasano mai
      var river = { y: y, wobble: wobble, slope: opts.slope || 0 };
      var step = 16;
      d = 'M ' + RIVER_LEFT + ' ' + riverY(river, RIVER_LEFT);
      for (var x = RIVER_LEFT + step; x < RIVER_RIGHT; x += step) d += ' L ' + x + ' ' + riverY(river, x);
      d += ' L ' + RIVER_RIGHT + ' ' + riverY(river, RIVER_RIGHT);
      for (var gx = 30; gx < RIVER_RIGHT - RIVER_LEFT; gx += 140) {
        var sx = RIVER_LEFT + gx;
        grassSpots.push({ x: sx, y: riverY(river, sx) });
      }
    }
    g.appendChild(el('path', { d: d, fill: 'none', stroke: 'var(--path-1)', 'stroke-width': 34, 'stroke-linecap':'round', opacity:.55 }));
    g.appendChild(el('path', { d: d, fill: 'none', stroke: 'var(--water-2)', 'stroke-width': 26, 'stroke-linecap':'round' }));
    g.appendChild(el('path', { d: d, fill: 'none', stroke: 'var(--water-1)', 'stroke-width': 15, 'stroke-linecap':'round' }));
    g.appendChild(el('path', { d: d, fill: 'none', stroke: 'white', 'stroke-width': 2, 'stroke-dasharray':'3 12', opacity:.55 }));
    grassSpots.forEach(function (p, i) {
      g.appendChild(drawTallGrass(p.x, p.y + (i % 2 ? 15 : -15), 0.85));
    });
    return g;
  }

  // ponte in legno: dove la strada attraversa un fiume, ha senso che ci sia un guado costruito
  function drawBridge(x, y, angle) {
    var g = el('g', { transform: 'translate(' + x + ',' + y + ') rotate(' + (angle || 0) + ')' });
    var w = 42, h = 46;
    g.appendChild(el('ellipse', { cx: 0, cy: h/2 + 3, rx: w/2 + 8, ry: 6, fill: '#000', opacity: 0.14 }));
    // piloni che affondano nell'acqua, ai due lati del ponte
    g.appendChild(el('rect', { x: -w/2 - 2, y: h/2 - 4, width: 6, height: 14, rx: 2, fill: 'var(--bark-dark)' }));
    g.appendChild(el('rect', { x: w/2 - 4, y: h/2 - 4, width: 6, height: 14, rx: 2, fill: 'var(--bark-dark)' }));
    g.appendChild(el('rect', { x: -w/2-4, y: -h/2, width: w+8, height: h, rx: 4, fill: 'var(--bark)' }));
    for (var i = -h/2+7; i <= h/2-7; i += 8) {
      g.appendChild(el('line', { x1: -w/2, y1: i, x2: w/2, y2: i, stroke: 'var(--bark-dark)', 'stroke-width': 2.4 }));
    }
    g.appendChild(el('rect', { x: -w/2-4, y: -h/2, width: 4.5, height: h, rx: 2, fill: 'var(--bark-dark)' }));
    g.appendChild(el('rect', { x: w/2-0.5, y: -h/2, width: 4.5, height: h, rx: 2, fill: 'var(--bark-dark)' }));
    // parapetti: pali verticali + corrimano, come un vero ponticello pedonale/carrabile
    [-h/2 + 3, -h/2 * 0.33, h/2 * 0.33, h/2 - 3].forEach(function (py) {
      g.appendChild(el('rect', { x: -w/2 - 6, y: py - 1.4, width: 3.6, height: 10, rx: 1.2, fill: 'var(--bark-dark)' }));
      g.appendChild(el('rect', { x: w/2 + 2.4, y: py - 1.4, width: 3.6, height: 10, rx: 1.2, fill: 'var(--bark-dark)' }));
    });
    g.appendChild(el('rect', { x: -w/2 - 6, y: -h/2 - 1, width: 3.6, height: h + 2, rx: 1.6, fill: 'var(--bark)' }));
    g.appendChild(el('rect', { x: w/2 + 2.4, y: -h/2 - 1, width: 3.6, height: h + 2, rx: 1.6, fill: 'var(--bark)' }));
    return g;
  }

