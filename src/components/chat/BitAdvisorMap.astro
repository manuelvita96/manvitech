  /* ============ RENDER MAPPA ============ */
  // agli step con questi indici, il bivio ha anche un terzo sentiero
  // decorativo bloccato da una roccia: sembra un vero incrocio a tre vie.
  var DEAD_END_STEPS = {}; // disattivato: causava una curva sovrapposta indesiderata vicino al sasso

  // I bivi non sono sempre una Y simmetrica: a rotazione diventano un "innesto"
  // (un ramo prosegue quasi dritto, l'altro si stacca prima e più deciso) o una
  // "deviazione" nell'altro senso — proprio come negli incroci reali.
  var FORK_STYLES = ['y', 'innesto-sx', 'innesto-dx'];
  function getForkGeometry(stepIndex, current) {
    var style = FORK_STYLES[stepIndex % FORK_STYLES.length];
    var L = { dx: -FORK_DX, bend: 0.35 }, R = { dx: FORK_DX, bend: 0.35 };
    if (style === 'innesto-sx') {
      // il sinistro si stacca presto e con più angolo, il destro resta quasi il tracciato principale
      L = { dx: -(FORK_DX + 24), bend: 0.22 };
      R = { dx: FORK_DX * 0.4,   bend: 0.55  };
    } else if (style === 'innesto-dx') {
      R = { dx: FORK_DX + 24,   bend: 0.22 };
      L = { dx: -(FORK_DX * 0.4), bend: 0.55 };
    }
    var leftX = current.x + L.dx, rightX = current.x + R.dx;
    // distanza minima garantita fra i due rami: cosi i cartelli non si toccano mai,
    // nemmeno quando il bivio è vicino al bordo della mappa e viene "clampato"
    var MIN_SEP = 120;
    if (rightX - leftX < MIN_SEP) {
      var mid = (leftX + rightX) / 2;
      leftX = mid - MIN_SEP / 2;
      rightX = mid + MIN_SEP / 2;
    }
    leftX = clampX(leftX); rightX = clampX(rightX);
    if (rightX - leftX < MIN_SEP) {
      if (leftX <= X_MIN + 1) rightX = clampX(leftX + MIN_SEP);
      else if (rightX >= X_MAX - 1) leftX = clampX(rightX - MIN_SEP);
    }
    return {
      left:  { x: leftX, y: current.y - STEP_DY, bend: L.bend },
      right: { x: rightX, y: current.y - STEP_DY, bend: R.bend }
    };
  }

  function renderWorld() {
    worldG.innerHTML = '';

    // decorazioni: prima gli oggetti "dietro" al sentiero
    DECOR.forEach(function (d) { worldG.appendChild(drawDecor(d)); });

    var buildingPoint = { x: 200, y: NODE_Y[5] };

    // raccolgo TUTTI i tratti di strada (percorso fatto + rami non scelti dei bivi
    // passati + bivio attivo + collegamento finale all'edificio) e li disegno in
    // un'unica rete: le giunzioni agli incroci restano sempre pulite.
    var pairs = [];
    for (var i = 1; i < state.nodes.length; i++) pairs.push({ a: state.nodes[i - 1], b: state.nodes[i], bend: state.nodes[i].bend });
    var backbone = pairs.slice(); // solo il percorso scelto: qui appendiamo l'arredo stradale (cartelli, lampioni)

    // i rami non scelti restano SEMPRE disegnati, esattamente come una strada
    // vera: è l'omino a scegliere una delle due, la strada non "sparisce"
    state.pastForks.forEach(function (f) {
      pairs.push({ a: f.current, b: f.unchosenPt, bend: f.unchosenPt.bend, isFork: true });
    });

    var current = state.nodes[state.nodes.length - 1];

    var active = null;
    if (state.phase === 'question' && state.stepIndex < TOTAL_QUESTIONS) {
      var q = getQuestion(state.stepIndex, state.data);
      var geo = getForkGeometry(state.stepIndex, current);
      active = { current: current, left: geo.left, right: geo.right, q: q };
      pairs.push({ a: current, b: geo.left, bend: geo.left.bend, isFork: true });
      pairs.push({ a: current, b: geo.right, bend: geo.right.bend, isFork: true });
    }

    // ogni nodo del percorso (compresi i bivi passati) è un vero incrocio:
    // qui vicino niente ciuffi, qualunque tratto li stia generando
    var junctions = state.nodes.concat(state.pastForks.map(function (f) { return f.current; }));
    drawRoadNetwork(worldG, pairs, PATH_W, junctions);

    // ogni bivio non ancora scelto finisce dentro un cespuglio, non con un
    // bordo arrotondato: non si sa ancora dove porti quella strada
    if (active) {
      worldG.appendChild(drawRoadBushCap(active.left.x, active.left.y));
      worldG.appendChild(drawRoadBushCap(active.right.x, active.right.y));
    }

    // arredo stradale: sempre ancorato alla VERA posizione del percorso scelto
    // in quel momento (mai coordinate fisse), perché la strada cambia forma a
    // ogni partita a seconda delle risposte dell'utente
    var sideFlip = 1;
    backbone.forEach(function (p) {
      if (!isAsphaltPair(p)) return;
      var mid = curvePointAt(p.a, p.b, p.bend, 0.5);
      var off = PATH_W/2 + 34;
      worldG.appendChild(drawStreetlamp(mid.x + mid.nx*off*sideFlip, mid.y + mid.ny*off*sideFlip));
      sideFlip *= -1;
    });
    // il cartello del paese va esattamente dove lo sterrato diventa asfalto:
    // il primo NODO del percorso già confermato che ricade in zona asfalto
    // (non un tratto "backbone" completo, che a fine partita potrebbe già
    // essere scorso fuori dalla vista quando viene disegnato)
    var firstAsphaltIdx = -1;
    for (var ni = 0; ni < state.nodes.length; ni++) {
      if (state.nodes[ni].y <= ASPHALT_Y) { firstAsphaltIdx = ni; break; }
    }
    if (firstAsphaltIdx > 0) {
      var signNode = state.nodes[firstAsphaltIdx];
      var signIn = { a: state.nodes[firstAsphaltIdx - 1], b: signNode, bend: signNode.bend };
      var signNormal = curvePointAt(signIn.a, signIn.b, signIn.bend, 1);
      var signOff = PATH_W/2 + 30;
      var signSide = signNormal.nx >= 0 ? 1 : -1;
      worldG.appendChild(drawTownSign(signNode.x - signOff*signSide - 6*signSide, signNode.y));
    }

    // dove la strada attraversa un fiume (dritto o obliquo), disegno un ponte
    computeBridges(pairs, DECOR).forEach(function (b) { worldG.appendChild(drawBridge(b.x, b.y, b.angle)); });

    // vicoli ciechi decorativi (passati + quello del bivio attivo)
    state.pastForks.forEach(function (f) { if (f.deadEnd) drawDeadEnd(worldG, f.current, f.deadEnd); });
    if (active && DEAD_END_STEPS[state.stepIndex]) drawDeadEnd(worldG, active.current, DEAD_END_STEPS[state.stepIndex]);

    // ogni ramo non scelto termina in modo naturale, come una stradina che
    // porta a un punto panoramico: un sasso alla punta, non un taglio netto
    state.pastForks.forEach(function (f) { worldG.appendChild(drawRock(f.unchosenPt.x, f.unchosenPt.y - 8, 0.6)); });

    // edificio finale sempre visibile in lontananza, con tanto di strisce pedonali
    // sull'asfalto appena prima dell'ingresso — ma solo una volta che la strada ci
    // è davvero arrivata (altrimenti comparirebbero nel prato, prima del tempo).
    // Piazzate esattamente sull'ultimo tratto vero (stessa curva, stessa tangente),
    // non su un punto fisso: se la strada arriva storta, le strisce seguono l'angolo giusto.
    var reachedBuilding = backbone.length > 0 && current.x === buildingPoint.x && current.y === buildingPoint.y;
    if (reachedBuilding) {
      var lastLeg = backbone[backbone.length - 1];
      var crossPt = curvePointAt(lastLeg.a, lastLeg.b, lastLeg.bend, 0.85);
      var angle = Math.atan2(crossPt.ty, crossPt.tx) * 180/Math.PI - 90;
      worldG.appendChild(drawCrosswalk(crossPt.x, crossPt.y, angle));
    }
    worldG.appendChild(drawBuilding(buildingPoint));

    // cartelli del bivio attivo (cliccabili), in un gruppo a parte così si possono
    // rimuovere senza toccare la strada, che resta per sempre
    if (active) worldG.appendChild(buildForkBadges(active));

    // avatar
    worldG.appendChild(drawAvatar(current));

    updateCamera(current, false);
  }

  function wrapLabel(label, maxChars) {
    var words = label.split(' ');
    var lines = [], cur = '';
    words.forEach(function (w) {
      var test = cur ? cur + ' ' + w : w;
      if (test.length > maxChars && cur) { lines.push(cur); cur = w; }
      else cur = test;
    });
    if (cur) lines.push(cur);
    return lines;
  }

  function buildForkBadges(active) {
    var layer = el('g', { id: 'activeForkBadges' });
    [ [active.left, active.q.left, 'left', 0], [active.right, active.q.right, 'right', 1] ].forEach(function (pair) {
      var pt = pair[0], opt = pair[1], side = pair[2], stagger = pair[3];
      // il cartello sta di fianco alla strada (non sopra, a bloccare la vista
      // di dove sparisce nel cespuglio): spostato di lato in orizzontale,
      // ma senza mai far uscire il pannello dal viewBox (400 di larghezza)
      var panelHalf = 56;
      var signX = pt.x + (side === 'left' ? -(PATH_W/2 + 34) : (PATH_W/2 + 34));
      signX = Math.max(panelHalf, Math.min(400 - panelHalf, signX));
      var g = el('g', {
        class: 'fork-hint',
        transform: 'translate(' + signX + ',' + pt.y + ')',
        tabindex: '0',
        role: 'button',
        'aria-label': 'Scegli: ' + opt.label
      });

      // riquadro bianco, con la risposta su una o due righe: mai troncata, mai a contatto col bordo
      var lines = wrapLabel(opt.label, 12);
      var panelW = 104;
      var lineH = 15;
      var padTop = 13, padBottom = 13, emojiRowH = 17;
      var panelH = padTop + emojiRowH + lines.length * lineH + padBottom;
      // piccolo sfalsamento estetico fra i due cartelli: la distanza minima fra i
      // rami è già garantita dalla geometria, quindi qui basta poco
      var lift = panelH / 2 + 14 + stagger * 10;

      // paletto: parte da terra e arriva esattamente al bordo inferiore del
      // pannello, qualunque sia la sua altezza — così restano sempre attaccati
      var poleBottom = 8;
      var poleTop = -lift + panelH / 2;
      g.appendChild(el('rect', { x: -2.5, y: poleTop, width: 5, height: poleBottom - poleTop, rx: 1.5, fill: 'var(--bark-dark)' }));

      var badge = el('g', { class: 'fork-badge', transform: 'translate(0,-' + lift + ')' });
      badge.appendChild(el('rect', { x: -panelW/2, y: -panelH/2, width: panelW, height: panelH, rx: 12, fill: 'white', stroke: 'var(--brand-500)', 'stroke-width': 2.5 }));
      var top = -panelH/2;
      var emoji = el('text', { x: 0, y: top + padTop + emojiRowH*0.68, 'text-anchor': 'middle', 'font-size': '16' });
      emoji.textContent = opt.emoji;
      badge.appendChild(emoji);
      lines.forEach(function (line, i) {
        var ty = top + padTop + emojiRowH + lineH * (i + 0.72);
        var lbl = el('text', { class: 'signpost-label', x: 0, y: ty, 'text-anchor': 'middle' });
        lbl.textContent = line;
        badge.appendChild(lbl);
      });
      g.appendChild(badge);

      g.addEventListener('click', function () { if (state.phase === 'question') chooseOption(side); });
      g.addEventListener('keydown', function (e) {
        if ((e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') && state.phase === 'question') {
          e.preventDefault();
          chooseOption(side);
        }
      });
      layer.appendChild(g);
    });
    return layer;
  }

  function updateCamera(node, animate, duration, focusY) {
    focusY = focusY === undefined ? FOCUS_Y : focusY;
    var target = focusY - node.y;
    if (!animate || REDUCE_MOTION) {
      worldG.setAttribute('transform', 'translate(0,' + target + ')');
      return;
    }
    var startVal = getCurrentTranslateY();
    animateValue(startVal, target, duration || 750, function (v) {
      worldG.setAttribute('transform', 'translate(0,' + v + ')');
    });
  }
  function getCurrentTranslateY() {
    var t = worldG.getAttribute('transform') || 'translate(0,0)';
    var m = /translate\(0,([-\d.]+)\)/.exec(t);
    return m ? parseFloat(m[1]) : 0;
  }

  function animateValue(from, to, duration, onUpdate, onDone) {
    var start = null;
    function tick(ts) {
      if (start === null) start = ts;
      var t = Math.min(1, (ts - start) / duration);
      var eased = t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2;
      onUpdate(from + (to - from) * eased);
      if (t < 1) requestAnimationFrame(tick); else if (onDone) onDone();
    }
    requestAnimationFrame(tick);
  }

  // Costruisce i punti intermedi lungo il percorso fra due nodi, campionando
  // la stessa curva disegnata (non più lo scheletro dritto): l'omino cammina
  // esattamente sopra alla strada che si vede, curve comprese.
  function buildWaypoints(a, b, spacing) {
    var approx = sampleCurve(a, b, b.bend, 40);
    var total = 0;
    for (var i = 1; i < approx.length; i++) total += Math.hypot(approx[i].x-approx[i-1].x, approx[i].y-approx[i-1].y);
    var steps = Math.max(1, Math.round(total / spacing));
    return sampleCurve(a, b, b.bend, steps);
  }

  function walkAvatar(fromNode, toNode, totalDuration, onDone) {
    var pos = document.getElementById('avatarPos');
    var bob = document.getElementById('avatarBob');
    var body = document.getElementById('avatarBody');
    var legL = document.getElementById('avatarLegL');
    var legR = document.getElementById('avatarLegR');
    if (REDUCE_MOTION) {
      // stesso risultato finale, ma senza l'animazione passo-passo
      if (pos) pos.setAttribute('transform', 'translate(' + toNode.x + ',' + toNode.y + ')');
      if (onDone) onDone();
      return;
    }
    var waypoints = buildWaypoints(fromNode, toNode, 32);
    var n = waypoints.length - 1;
    if (n < 1) { if (onDone) onDone(); return; }
    var hopDur = Math.max(90, totalDuration / n);
    if (bob) bob.classList.add('walking'); // ferma il dondolio "a riposo": ora cammina davvero
    var idx = 0;

    function hop() {
      if (idx >= n) { finish(); return; }
      var p0 = waypoints[idx], p1 = waypoints[idx + 1];
      var angle = p1.x > p0.x ? 14 : (p1.x < p0.x ? -14 : 0);
      if (body) body.setAttribute('transform', 'rotate(' + angle + ')');
      var forward = idx % 2 === 0;
      if (legL) legL.setAttribute('transform', 'translate(0,' + (forward ? -2 : 2) + ')');
      if (legR) legR.setAttribute('transform', 'translate(0,' + (forward ? 2 : -2) + ')');
      var start = null;
      function frame(ts) {
        if (start === null) start = ts;
        var t = Math.min(1, (ts - start) / hopDur);
        var x = p0.x + (p1.x - p0.x) * t;
        var y = p0.y + (p1.y - p0.y) * t;
        var bounce = Math.sin(Math.PI * t) * 3.4; // arco del passo
        if (pos) pos.setAttribute('transform', 'translate(' + x + ',' + y + ')');
        if (bob) bob.style.transform = 'translateY(-' + bounce + 'px)';
        if (t < 1) requestAnimationFrame(frame); else { idx++; hop(); }
      }
      requestAnimationFrame(frame);
    }
    function finish() {
      if (body) body.setAttribute('transform', 'rotate(0)');
      if (legL) legL.removeAttribute('transform');
      if (legR) legR.removeAttribute('transform');
      if (bob) { bob.classList.remove('walking'); bob.style.transform = ''; }
      if (onDone) onDone();
    }
    hop();
  }

  /* ============ DIALOGO (typewriter) ============ */
  var dialogueEl = document.getElementById('dialogueText');
  var dialogueTag = document.getElementById('dialogueTag');
  var typingTimer = null, fullText = '', onTypedDone = null, isTyping = false;

  function say(who, text, cb) {
    if (typingTimer) clearInterval(typingTimer);
    dialogueTag.textContent = who === 'bit' ? 'Bit' : 'Tu';
    dialogueTag.className = 'dialogue-tag' + (who === 'user' ? ' user-tag' : '');
    fullText = text; onTypedDone = cb; isTyping = true;
    var i = 0;
    dialogueEl.innerHTML = '';
    typingTimer = setInterval(function () {
      i++;
      dialogueEl.textContent = text.slice(0, i);
      if (i >= text.length) {
        clearInterval(typingTimer); isTyping = false;
        var c = onTypedDone; onTypedDone = null;
        if (c) c();
      }
    }, 16);
  }
  function skipTyping() {
    if (!isTyping) return;
    clearInterval(typingTimer);
    dialogueEl.textContent = fullText;
    isTyping = false;
    var c = onTypedDone; onTypedDone = null;
    if (c) c();
  }
  document.getElementById('dialogue').addEventListener('click', skipTyping);

  /* ============ HUD ============ */
  function updateHud() {
    var stepNum = 1;
    if (state.phase === 'question') stepNum = state.stepIndex + 1;
    else if (state.phase === 'summary') stepNum = 5;
    else if (state.phase === 'done') stepNum = 6;
    document.getElementById('hudStep').textContent = 'Passo ' + stepNum + '/6';
    document.getElementById('hudBarFill').style.width = (stepNum / 6 * 100) + '%';
    var starsEl = document.getElementById('hudStars');
    starsEl.textContent = '⭐ ' + state.combo;
  }
  function celebrateCombo() {
    state.combo = Math.min(state.combo + 1, 6);
    var starsEl = document.getElementById('hudStars');
    starsEl.classList.remove('pop'); void starsEl.offsetWidth; starsEl.classList.add('pop');
    sounds.star();
    updateHud();
  }
  document.getElementById('hudSound').addEventListener('click', function () {
    state.soundOn = !state.soundOn;
    this.textContent = state.soundOn ? '🔊' : '🔇';
  });

  /* ============ RISPOSTE / UI AREA ============ */
  var answersEl = document.getElementById('answers');

  function renderNameForm() {
    answersEl.innerHTML =
      '<div class="name-row">' +
        '<input id="nameInput" class="text-input" placeholder="Scrivi qui il tuo nome…" autofocus />' +
        '<button id="nameBtn" class="bit-btn-primary" disabled>Parti</button>' +
      '</div>';
    var input = document.getElementById('nameInput');
    var btn = document.getElementById('nameBtn');
    input.addEventListener('input', function () { btn.disabled = !input.value.trim(); });
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter' && input.value.trim()) submitName(); });
    btn.addEventListener('click', submitName);
    function submitName() {
      var val = input.value.trim(); if (!val) return;
      state.data.name = val;
      sounds.tap(); celebrateCombo();
      say('user', val, function () {
        setTimeout(startQuestions, 450);
      });
      answersEl.innerHTML = '';
    }
  }

  function renderChoiceButtons(q) {
    answersEl.innerHTML =
      '<div class="choices-row">' +
        '<button class="choice-btn" id="btnLeft" style="--btn-shadow:#DB6A1E; background:linear-gradient(135deg,#ED7D31,#F0396A);">' +
          '<span class="choice-arrow">⬅ sinistra</span><span class="choice-emoji">' + q.left.emoji + '</span><span>' + q.left.label + '</span>' +
        '</button>' +
        '<button class="choice-btn" id="btnRight" style="--btn-shadow:#B31E44; background:linear-gradient(135deg,#F0396A,#262626);">' +
          '<span class="choice-arrow">destra ➡</span><span class="choice-emoji">' + q.right.emoji + '</span><span>' + q.right.label + '</span>' +
        '</button>' +
      '</div>';
    document.getElementById('btnLeft').addEventListener('click', function () { chooseOption('left'); });
    document.getElementById('btnRight').addEventListener('click', function () { chooseOption('right'); });
  }

  function renderSummaryForm() {
    var firstName = state.data.name.split(' ')[0];
    answersEl.innerHTML =
      '<form class="email-form" id="summaryForm">' +
        '<input type="email" required id="emailInput" class="text-input" placeholder="La tua email *" />' +
        '<input id="phoneInput" class="text-input" placeholder="Telefono (facoltativo)" />' +
        '<label class="consent"><input type="checkbox" required id="consentInput" /><span>Ho letto l’informativa privacy e acconsento al trattamento dei miei dati. *</span></label>' +
        '<button type="submit" class="bit-btn-primary" id="submitBtn" disabled style="width:fit-content;">Invia a Bit</button>' +
      '</form>';
    var email = document.getElementById('emailInput');
    var consent = document.getElementById('consentInput');
    var submitBtn = document.getElementById('submitBtn');
    function checkValid() { submitBtn.disabled = !(email.value && consent.checked); }
    email.addEventListener('input', checkValid);
    consent.addEventListener('change', checkValid);
    document.getElementById('summaryForm').addEventListener('submit', function (e) {
      e.preventDefault();
      state.data.email = email.value;
      state.data.phone = document.getElementById('phoneInput').value;
      submitLead();
    });
  }

  /* ============ FLUSSO DI GIOCO ============ */
  function startQuestions() {
    state.phase = 'question';
    updateHud();
    saveProgress();
    askCurrentQuestion();
  }

  function askCurrentQuestion() {
    var q = getQuestion(state.stepIndex, state.data);
    answersEl.innerHTML = '';
    renderWorld(); // mostra il bivio fantasma
    say('bit', q.text, function () {
      renderChoiceButtons(q);
    });
  }

  function chooseOption(side) {
    var q = getQuestion(state.stepIndex, state.data);
    var opt = side === 'left' ? q.left : q.right;
    state.data[q.key] = opt.value;
    answersEl.innerHTML = '';

    var current = state.nodes[state.nodes.length - 1];
    var isLastQuestion = state.stepIndex === TOTAL_QUESTIONS - 1;
    var geo = getForkGeometry(state.stepIndex, current);
    var chosenPt = side === 'left' ? geo.left : geo.right;
    var unchosenPt = side === 'left' ? geo.right : geo.left;
    var nextNode = { x: chosenPt.x, y: chosenPt.y, bend: chosenPt.bend };
    var stepIndexNow = state.stepIndex;

    sounds.tap(); celebrateCombo();
    say('user', opt.label, function () {
      setTimeout(function () {
        sounds.step();
        // il bivio diventa storia: il ramo non scelto resta sulla mappa per sempre,
        // spariscono solo i cartelli cliccabili (la strada l'ha già disegnata renderWorld)
        var badges = document.getElementById('activeForkBadges');
        if (badges) badges.remove();
        state.pastForks.push({ current: { x: current.x, y: current.y }, unchosenPt: unchosenPt, bend: unchosenPt.bend, deadEnd: DEAD_END_STEPS[stepIndexNow] || null });
        state.nodes.push(nextNode);
        state.stepIndex++;
        saveProgress();

        var walkDur = REDUCE_MOTION ? 60 : 900;
        walkAvatar(current, nextNode, walkDur, function () {
          updateCamera(nextNode, false);
          if (isLastQuestion) {
            var buildingPoint = { x: 200, y: NODE_Y[5], bend: 0.5 };
            state.nodes.push(buildingPoint); // ora è un nodo vero: la mappa lo ricorda sempre
            // ridisegno SUBITO tutta la scena finale (strada, lampioni, cartello,
            // strisce, edificio): così l'omino le vede comparire mentre cammina
            // verso casa, non solo una volta già arrivato
            renderWorld();
            var freshAvatar = document.getElementById('avatarPos');
            if (freshAvatar) freshAvatar.setAttribute('transform', 'translate(' + nextNode.x + ',' + nextNode.y + ')');
            var lastLeg = REDUCE_MOTION ? 60 : 1200;
            // la telecamera si sposta verso l'inquadratura d'arrivo (edificio
            // in alto): niente più schermo vuoto sopra casa, si vede tutto
            // l'ultimo tratto mentre viene percorso
            updateCamera(buildingPoint, true, lastLeg, ARRIVAL_FOCUS_Y);
            walkAvatar(nextNode, buildingPoint, lastLeg, function () {
              updateCamera(buildingPoint, false, 0, ARRIVAL_FOCUS_Y);
              arriveAtBuilding();
            });
          }
        });
        updateCamera(nextNode, true, walkDur);

        if (!isLastQuestion) {
          setTimeout(function () { state.phase = 'question'; updateHud(); askCurrentQuestion(); }, walkDur + 150);
        } else {
          updateHud();
        }
      }, 450);
    });
  }

  function arriveAtBuilding() {
    state.phase = 'summary';
    updateHud();
    saveProgress();
    renderWorld();
    var buildingPoint = { x: 200, y: NODE_Y[5] };

    // l'omino non "esce" dalla scena: si avvicina alla porta e si dissolve dolcemente
    // sul posto, poi ricompare alla finestra a salutare
    setTimeout(function () {
      var avatarPos = document.getElementById('avatarPos');
      if (avatarPos) {
        // la posizione dell'omino è impostata via attributo SVG (translate),
        // non via CSS: fisso qui lo stato di partenza identico, altrimenti la
        // transizione CSS lo farebbe "volare" verso l'origine (0,0) della mappa
        avatarPos.style.transformBox = 'fill-box';
        avatarPos.style.transform = 'translate(' + buildingPoint.x + 'px,' + buildingPoint.y + 'px)';
        avatarPos.style.transition = 'opacity .45s ease, transform .45s ease';
        requestAnimationFrame(function () {
          avatarPos.style.opacity = '0';
          avatarPos.style.transform = 'translate(' + buildingPoint.x + 'px,' + buildingPoint.y + 'px) scale(0.82) translateY(-3px)';
        });
      }
      setTimeout(function () {
        var bg = document.getElementById('buildingGroup');
        if (bg && !document.getElementById('waveFigure')) {
          bg.appendChild(drawWaveFigure());
          sounds.tap();
        }
      }, 420);
    }, 300);

    var firstName = state.data.name.split(' ')[0];
    say('bit', 'Siamo arrivati! Lascia qui la tua email' + (firstName ? ', ' + firstName : '') + ': il team di manvitech ti ricontatta a breve. 🙂', function () {
      renderSummaryForm();
    });
  }

  function launchConfetti() {
    var mapWrap = document.querySelector('.map-wrap');
    var colors = ['#ED7D31', '#F0396A', '#FFC79A', '#262626'];
    for (var i = 0; i < 22; i++) {
      var piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.cssText = 'position:absolute;top:0;left:' + (Math.random()*100) + '%;width:7px;height:12px;border-radius:2px;background:' + colors[i % colors.length] + ';animation-delay:' + (Math.random()*0.4) + 's;animation-duration:' + (1.4+Math.random()*0.8) + 's;';
      mapWrap.appendChild(piece);
      (function (p) { setTimeout(function () { p.remove(); }, 2400); })(piece);
    }
  }

  function submitLead() {
    var submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true; submitBtn.textContent = 'Invio in corso…';

    // Invio reale a Netlify Forms: stesso meccanismo del form "ombra" nascosto
    // nella pagina (form-name + campi con lo stesso nome), cosi Netlify
    // riconosce e inoltra la sottomissione esattamente come faceva il vecchio form.
    var payload = {
      'form-name': 'chiedi-a-bit',
      'bot-field': '',
      name: state.data.name,
      hasSite: state.data.hasSite,
      siteProblem: state.data.siteProblem,
      siteUrl: '',
      businessType: state.data.businessType,
      targetAudience: state.data.targetAudience,
      timeline: state.data.timeline,
      email: state.data.email,
      phone: state.data.phone,
      privacyConsent: 'true'
    };
    var body = Object.keys(payload).map(function (k) {
      return encodeURIComponent(k) + '=' + encodeURIComponent(payload[k]);
    }).join('&');

    fetch(window.location.pathname, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body
    }).then(function (res) {
      if (!res.ok) throw new Error('Errore invio');
      state.phase = 'done';
      clearProgress();
      celebrateCombo();
      sounds.celebrate();
      launchConfetti();
      answersEl.innerHTML = '<div class="success-banner">🎉 Missione compiuta! Ti ricontattiamo presto.</div>';
      var firstName = state.data.name.split(' ')[0];
      say('bit', 'Fatto' + (firstName ? ', ' + firstName : '') + '! 🎉 Ho passato tutto al team: ti ricontattiamo entro 24 ore lavorative.');
      bumpWaveFigure();
    }).catch(function () {
      submitBtn.disabled = false; submitBtn.textContent = 'Invia a Bit';
      var form = document.getElementById('summaryForm');
      if (form && !document.getElementById('submitError')) {
        var err = document.createElement('p');
        err.id = 'submitError';
        err.style.cssText = 'color:var(--accent-600);font-size:12px;margin:0;';
        err.textContent = 'Ops, qualcosa è andato storto. Riprova, oppure scrivici a info@manvitech.it';
        form.appendChild(err);
      }
    });
  }

  /* ============ PROGRESSO SALVATO ============ */
  // Se l'utente ricarica la pagina o chiude il browser per sbaglio, non deve
  // ritrovarsi da capo: salviamo lo stato di gioco in locale (solo su questo
  // dispositivo, nulla lascia mai il browser finché non viene inviato il form).
  var STORAGE_KEY = 'manvitechBitProgress';
  function saveProgress() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify({
        stepIndex: state.stepIndex,
        data: state.data,
        nodes: state.nodes,
        pastForks: state.pastForks,
        combo: state.combo,
        phase: state.phase
      }));
    } catch (e) { /* storage non disponibile: nessun problema, si continua senza salvare */ }
  }
  function clearProgress() {
    try { window.localStorage.removeItem(STORAGE_KEY); } catch (e) {}
  }
  function loadProgress() {
    try {
      var raw = window.localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      var saved = JSON.parse(raw);
      if (!saved || saved.phase === 'done' || saved.phase === 'name') return null;
      if (!saved.data || !saved.data.name) return null;
      return saved;
    } catch (e) { return null; }
  }
  function resumeProgress(saved) {
    state.stepIndex = saved.stepIndex || 0;
    state.data = saved.data;
    state.nodes = saved.nodes && saved.nodes.length ? saved.nodes : state.nodes;
    state.pastForks = saved.pastForks || [];
    state.combo = saved.combo || 0;
    state.phase = saved.phase;
    updateHud();
    renderWorld();
    var firstName = state.data.name ? state.data.name.split(' ')[0] : '';
    if (state.phase === 'summary') {
      say('bit', 'Bentornato' + (firstName ? ', ' + firstName : '') + '! Riprendiamo da qui: mi lasci un contatto?', function () { renderSummaryForm(); });
    } else {
      say('bit', 'Bentornato' + (firstName ? ', ' + firstName : '') + '! Riprendiamo da dove avevamo lasciato.', function () { askCurrentQuestion(); });
    }
  }
  function offerResume(saved) {
    say('bit', 'Ciao, bentornato! 👋 Ho ancora salvata la partita di prima. Continuiamo da lì o ricominciamo da capo?', function () {
      answersEl.innerHTML =
        '<div class="choices-row">' +
          '<button class="choice-btn" id="btnResumeYes" style="--btn-shadow:#1E7A46; background:linear-gradient(135deg,#2E9E5B,#1E7A46);">' +
            '<span class="choice-emoji">▶️</span><span>Continua da lì</span>' +
          '</button>' +
          '<button class="choice-btn" id="btnResumeNo" style="--btn-shadow:#DB6A1E; background:linear-gradient(135deg,#ED7D31,#F0396A);">' +
            '<span class="choice-emoji">↺</span><span>Ricomincia</span>' +
          '</button>' +
        '</div>';
      document.getElementById('btnResumeYes').addEventListener('click', function () { answersEl.innerHTML = ''; resumeProgress(saved); });
      document.getElementById('btnResumeNo').addEventListener('click', function () { clearProgress(); doReset(); });
    });
  }

  /* ============ AVVIO ============ */
  function doReset() {
    clearProgress();
    var soundWas = state.soundOn;
    state.stepIndex = 0;
    state.data = { name: '', hasSite:'', siteProblem:'', businessType:'', targetAudience:'', timeline:'', email:'', phone:'', consent:false };
    state.nodes = [{ x: 200, y: NODE_Y[0] }];
    state.pastForks = [];
    state.combo = 0;
    state.soundOn = soundWas;
    state.phase = 'name';
    var w = document.getElementById('waveFigure');
    if (w && w.parentNode) w.parentNode.removeChild(w);
    init();
  }

  function resetGame() {
    // niente confirm() nativo: nelle webview integrate spesso non funziona.
    // Chiedo conferma con i bottoni di gioco che già usiamo per le risposte.
    say('bit', 'Vuoi ricominciare da capo? I progressi di questa partita andranno persi. 🙂', function () {
      answersEl.innerHTML =
        '<div class="choices-row">' +
          '<button class="choice-btn" id="btnResetYes" style="--btn-shadow:#B31E44; background:linear-gradient(135deg,#F0396A,#262626);">' +
            '<span class="choice-emoji">↺</span><span>Sì, ricomincia</span>' +
          '</button>' +
          '<button class="choice-btn" id="btnResetNo" style="--btn-shadow:#DB6A1E; background:linear-gradient(135deg,#ED7D31,#F0396A);">' +
            '<span class="choice-emoji">↩️</span><span>No, continua</span>' +
          '</button>' +
        '</div>';
      document.getElementById('btnResetYes').addEventListener('click', doReset);
      document.getElementById('btnResetNo').addEventListener('click', function () {
        // torna alla schermata corretta in base a dove eravamo rimasti
        if (state.phase === 'name') { say('bit', 'Ok, continuiamo da qui! Come ti chiami?', function () { renderNameForm(); }); }
        else if (state.phase === 'question') { askCurrentQuestion(); }
        else if (state.phase === 'summary') { say('bit', 'Ok, continuiamo da qui!', function () { renderSummaryForm(); }); }
        else { answersEl.innerHTML = ''; }
      });
    });
  }
  document.getElementById('hudRestart').addEventListener('click', resetGame);

  function init() {
    updateHud();
    renderWorld();
    var saved = loadProgress();
    if (saved) { offerResume(saved); return; }
    say('bit', 'Ciao! Sono Bit 👋 Ti aiuto a capire da dove partire con il tuo sito. Come ti chiami?', function () {
      renderNameForm();
    });
  }
  init();
})();
</script>