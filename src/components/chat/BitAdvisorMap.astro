  // strisce pedonali davanti all'ufficio: larghe quanto la strada asfaltata,
  // ruotate secondo la tangente reale della strada in quel punto (se la
  // strada arriva storta, le strisce seguono lo stesso angolo, non restano dritte a caso)
  function drawCrosswalk(x, y, angle) {
    var g = el('g', { transform: 'translate(' + x + ',' + y + ') rotate(' + (angle || 0) + ')' });
    var roadW = PATH_W + 4; // deve combaciare con lo spessore del cordolo dell'asfalto
    var stripeW = 6, gap = 5.5;
    var n = Math.floor(roadW / (stripeW + gap));
    var totalW = n * stripeW + (n - 1) * gap;
    var startX = -totalW / 2 + stripeW / 2;
    for (var i = 0; i < n; i++) {
      g.appendChild(el('rect', { x: startX + i * (stripeW + gap) - stripeW / 2, y: -20, width: stripeW, height: 40, rx: 1.2, fill: '#F4EFE2', opacity: 0.92 }));
    }
    return g;
  }

  function drawDecor(d) {
    switch (d.type) {
      case 'tree': return drawTree(d.x, d.y, d.s);
      case 'fruit-tree': return drawTree(d.x, d.y, d.s, d.fruit || 'red');
      case 'bush': return drawBush(d.x, d.y, d.s);
      case 'fruit-bush': return drawBush(d.x, d.y, d.s, true);
      case 'rock': return drawRock(d.x, d.y, d.s);
      case 'flower': return drawFlowers(d.x, d.y);
      case 'water': return drawWater(d.x, d.y);
      case 'pebbles': return drawPebbles(d.x, d.y, d.s);
      case 'mushroom': return drawMushroom(d.x, d.y, d.s);
      case 'fence': return drawFence(d.x, d.y, d.s);
      case 'haystack': return drawHaystack(d.x, d.y, d.s);
      case 'hill': return drawHill(d.x, d.y, d.s);
      case 'tallgrass': return drawTallGrass(d.x, d.y, d.s);
      case 'river': return drawRiver(d.y, d.wobble || 16, { slope: d.slope || 0, loop: d.loop, side: d.side });
    }
  }

