      g.appendChild(el('path', { d: 'M ' + bx + ' 2 Q ' + (bx+3) + ' ' + (-h*0.5) + ' ' + (bx+1) + ' ' + (-h), stroke: 'var(--grass-tuft)', 'stroke-width': 3, fill: 'none', 'stroke-linecap':'round' }));
    });
